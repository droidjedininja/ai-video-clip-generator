# Optional local settings. No API key is required.
WHISPER_MODEL=tiny
WHISPER_TIMEOUT_SECONDS=600
# Set to 1 only after this model has been downloaded into the cache.
WHISPER_OFFLINE=0

# Jobs expire after completion; cleanup also runs at startup.
JOB_RETENTION_HOURS=24
JOB_CLEANUP_INTERVAL_SECONDS=300
